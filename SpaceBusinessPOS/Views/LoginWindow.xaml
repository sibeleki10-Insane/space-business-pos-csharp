<Window x:Class="SpaceBusinessPOS.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Space-Business POS — Login"
        Width="480" Height="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#111111"
        TextElement.Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">

            <!-- Logo / Branding -->
            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,32">
                <TextBlock HorizontalAlignment="Center" FontSize="36" FontWeight="Black" LetterSpacing="4">
                    <Run Text="SPACE" Foreground="#D97B35"/>
                    <Run Text="CODE" Foreground="White"/>
                </TextBlock>
                <TextBlock Text="TECHNOLOGIES" HorizontalAlignment="Center"
                           FontSize="11" FontWeight="SemiBold" LetterSpacing="6"
                           Foreground="#6B7280" Margin="0,4,0,8"/>
                <TextBlock Text="Space-Business POS" HorizontalAlignment="Center"
                           FontSize="14" Foreground="#9CA3AF"/>
            </StackPanel>

            <!-- PIN Display -->
            <Border Background="#1A1A1A" CornerRadius="12" Padding="24,20" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Enter PIN" HorizontalAlignment="Center"
                               FontSize="14" Foreground="#6B7280" Margin="0,0,0,16"/>

                    <!-- PIN Dots -->
                    <ItemsControl HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Ellipse Width="16" Height="16" Margin="6,0"
                                         Fill="{Binding}" Stroke="#374151" StrokeThickness="1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- PIN dots bound from code-behind -->
                    <StackPanel x:Name="PinDotsPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0"/>

                    <!-- Error -->
                    <TextBlock x:Name="ErrorText" Text="" HorizontalAlignment="Center"
                               Foreground="#EF4444" FontSize="13" Margin="0,12,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- Keypad -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="64"/>
                </Grid.RowDefinitions>

                <!-- Row 1: 1 2 3 -->
                <Button Content="1" Grid.Row="0" Grid.Column="0" Margin="4" Tag="1" Click="KeypadClick" Style="{StaticResource KeypadButtonStyle}"/>
                <Button Content="2" Grid.Row="0" Grid.Column="1" Margin="4" Tag="2" Click="KeypadClick" Style="{StaticResource KeypadButtonStyle}"/>
                <Button Content="3" Grid.Row="0" Grid.Column="2" Margin="4" Tag="3" Click="KeypadClick" Style="{StaticResource KeypadButtonStyle}"/>

                <!-- Row 2: 4 5 6 -->
                <Button Content="4" Grid.Row="1" Grid.Column="0" Margin="4" Tag="4" Click="KeypadClick" Style="{StaticResource KeypadButtonStyle}"/>
                <Button Content="5" Grid.Row="1" Grid.Column="1" Margin="4" Tag="5" Click="KeypadClick" Style="{StaticResource KeypadButtonStyle}"/>
                <Button Content="6" Grid.Row="1" Grid.Column="2" Margin="4" Tag="6" Click="KeypadClick" Style="{StaticResource KeypadButtonStyle}"/>

                <!-- Row 3: 7 8 9 -->
                <Button Content="7" Grid.Row="2" Grid.Column="0" Margin="4" Tag="7" Click="KeypadClick" Style="{StaticResource KeypadButtonStyle}"/>
                <Button Content="8" Grid.Row="2" Grid.Column="1" Margin="4" Tag="8" Click="KeypadClick" Style="{StaticResource KeypadButtonStyle}"/>
                <Button Content="9" Grid.Row="2" Grid.Column="2" Margin="4" Tag="9" Click="KeypadClick" Style="{StaticResource KeypadButtonStyle}"/>

                <!-- Row 4: Clear 0 ⌫ -->
                <Button Content="C" Grid.Row="3" Grid.Column="0" Margin="4" Click="ClearClick" Style="{StaticResource KeypadButtonStyle}"/>
                <Button Content="0" Grid.Row="3" Grid.Column="1" Margin="4" Tag="0" Click="KeypadClick" Style="{StaticResource KeypadButtonStyle}"/>
                <Button Content="⌫" Grid.Row="3" Grid.Column="2" Margin="4" Click="BackspaceClick" Style="{StaticResource KeypadButtonStyle}"/>
            </Grid>

            <!-- Login Button -->
            <Button Content="LOGIN" Click="LoginClick" Margin="0,16,0,0"
                    Height="48" FontSize="16" FontWeight="Bold"
                    Background="#D97B35" Foreground="White" BorderThickness="0"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#C4621C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </StackPanel>
    </Grid>

    <Window.Resources>
        <Style x:Key="KeypadButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D97B35"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#C4621C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
</Window>
