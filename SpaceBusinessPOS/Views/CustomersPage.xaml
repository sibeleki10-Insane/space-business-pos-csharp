<Page x:Class="SpaceBusinessPOS.Views.CustomersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:vm="clr-namespace:SpaceBusinessPOS.ViewModels"
      xmlns:conv="clr-namespace:SpaceBusinessPOS.Converters"
      Background="#111111" FontFamily="Segoe UI">
    <Page.DataContext><vm:CustomersViewModel/></Page.DataContext>
    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BTV"/>
        <conv:InverseBoolToVisibilityConverter x:Key="IBTV"/>
    </Page.Resources>
    <Grid Margin="20">
        <DockPanel Visibility="{Binding IsEditing, Converter={StaticResource IBTV}}">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="Customers" Style="{StaticResource SectionHeader}" VerticalAlignment="Center"/>
                <Button Content="+ New Customer" HorizontalAlignment="Right" Command="{Binding NewCustomerCommand}" Style="{StaticResource OrangeButton}"/>
            </Grid>
            <TextBox DockPanel.Dock="Top" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="Search by name, phone, email..."
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Width="320" HorizontalAlignment="Left" Foreground="White" Background="#232323" Margin="0,0,0,12"/>
            <DataGrid DockPanel.Dock="Top" ItemsSource="{Binding Customers}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      Background="#1A1A1A" Foreground="White"
                      RowBackground="#232323" AlternatingRowBackground="#1E1E1E"
                      BorderThickness="0" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#2D2D2D"
                      CanUserResizeRows="False" SelectionMode="Single">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#1A1A1A"/>
                        <Setter Property="Foreground" Value="#9CA3AF"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#2D2D2D"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                    <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="120"/>
                    <DataGridTextColumn Header="Points" Binding="{Binding LoyaltyPoints}" Width="80"/>
                    <DataGridTemplateColumn Header="Actions" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Edit" Margin="2" Padding="8,2"
                                            Command="{Binding DataContext.EditCustomerCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            Background="#D97B35" Foreground="White" BorderThickness="0" FontSize="11"/>
                                    <Button Content="Del" Margin="2" Padding="8,2"
                                            Command="{Binding DataContext.DeleteCustomerCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            Background="#EF4444" Foreground="White" BorderThickness="0" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
        <ScrollViewer Visibility="{Binding IsEditing, Converter={StaticResource BTV}}">
            <StackPanel MaxWidth="520" HorizontalAlignment="Left">
                <TextBlock Text="Customer Details" Style="{StaticResource SectionHeader}"/>
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="Full Name *" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Foreground="White" Background="#1A1A1A" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Email" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditEmail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Foreground="White" Background="#1A1A1A"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Phone" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Foreground="White" Background="#1A1A1A"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Address" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Foreground="White" Background="#1A1A1A" Margin="0,0,0,12"/>
                        <TextBlock Text="Notes" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Foreground="White" Background="#1A1A1A" AcceptsReturn="True" Height="80" Margin="0,0,0,12"/>
                        <TextBlock Text="Loyalty Points" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditLoyaltyPoints, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Foreground="White" Background="#1A1A1A" Margin="0,0,0,16"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#EF4444" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Save Customer" Command="{Binding SaveCustomerCommand}" Style="{StaticResource OrangeButton}" Margin="0,0,8,0"/>
                            <Button Content="Cancel" Command="{Binding CancelEditCommand}" Style="{StaticResource GhostButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
