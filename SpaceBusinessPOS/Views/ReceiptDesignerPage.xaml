<Page x:Class="SpaceBusinessPOS.Views.ReceiptDesignerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:vm="clr-namespace:SpaceBusinessPOS.ViewModels"
      Background="#111111" FontFamily="Segoe UI">
    <Page.DataContext><vm:ReceiptDesignerViewModel/></Page.DataContext>
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- Settings Panel -->
        <ScrollViewer Grid.Column="0">
            <StackPanel>
                <TextBlock Text="Receipt Designer" Style="{StaticResource SectionHeader}"/>
                <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Business Info" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                        <TextBlock Text="Business Name" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding BusinessName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Foreground="White" Background="#1A1A1A" Margin="0,0,0,12"/>
                        <TextBlock Text="Address" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding BusinessAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Foreground="White" Background="#1A1A1A" Margin="0,0,0,12"/>
                        <TextBlock Text="Phone" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding BusinessPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Foreground="White" Background="#1A1A1A"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Messages" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                        <TextBlock Text="Header Message" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Header, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Foreground="White" Background="#1A1A1A" Margin="0,0,0,12" AcceptsReturn="True" Height="60"/>
                        <TextBlock Text="Footer Message" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Footer, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Foreground="White" Background="#1A1A1A" AcceptsReturn="True" Height="60"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Options" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                        <CheckBox Content="Show tax breakdown" IsChecked="{Binding ShowTaxBreakdown}" Foreground="White" Margin="0,0,0,8"/>
                        <CheckBox Content="Show customer name" IsChecked="{Binding ShowCustomerInfo}" Foreground="White" Margin="0,0,0,12"/>
                        <TextBlock Text="Font Size" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding FontSizes}" SelectedItem="{Binding FontSize}"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Foreground="White" Background="#1A1A1A"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#22C55E" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Save Template" Command="{Binding SaveCommand}" Style="{StaticResource OrangeButton}" Margin="0,0,8,0"/>
                    <Button Content="Preview" Command="{Binding UpdatePreviewCommand}" Style="{StaticResource GhostButton}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Preview -->
        <Border Grid.Column="2" Background="#1A1A1A" CornerRadius="8" Padding="12">
            <StackPanel>
                <TextBlock Text="Preview" FontWeight="SemiBold" Foreground="#9CA3AF" FontSize="13" Margin="0,0,0,12"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBox Text="{Binding PreviewText}" IsReadOnly="True"
                             FontFamily="Courier New" FontSize="11"
                             Background="#111111" Foreground="White" BorderThickness="0"
                             AcceptsReturn="True" TextWrapping="Wrap" Padding="8"/>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</Page>
