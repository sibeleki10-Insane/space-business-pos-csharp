<Page x:Class="SpaceBusinessPOS.Views.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:vm="clr-namespace:SpaceBusinessPOS.ViewModels"
      xmlns:conv="clr-namespace:SpaceBusinessPOS.Converters"
      Background="#111111" FontFamily="Segoe UI">
    <Page.DataContext><vm:UsersViewModel/></Page.DataContext>
    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BTV"/>
        <conv:InverseBoolToVisibilityConverter x:Key="IBTV"/>
    </Page.Resources>
    <Grid Margin="20">
        <DockPanel Visibility="{Binding IsEditing, Converter={StaticResource IBTV}}">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                <TextBlock Text="User Manager" Style="{StaticResource SectionHeader}" VerticalAlignment="Center"/>
                <Button Content="+ Add User" HorizontalAlignment="Right" Command="{Binding NewUserCommand}" Style="{StaticResource OrangeButton}"/>
            </Grid>
            <DataGrid DockPanel.Dock="Top" ItemsSource="{Binding Users}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      Background="#1A1A1A" Foreground="White"
                      RowBackground="#232323" AlternatingRowBackground="#1E1E1E"
                      BorderThickness="0" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#2D2D2D"
                      CanUserResizeRows="False" SelectionMode="Single">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#1A1A1A"/>
                        <Setter Property="Foreground" Value="#9CA3AF"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#2D2D2D"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                    <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="100"/>
                    <DataGridTextColumn Header="PIN" Binding="{Binding Pin}" Width="80"/>
                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60"/>
                    <DataGridTemplateColumn Header="Actions" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Edit" Margin="2" Padding="8,2"
                                            Command="{Binding DataContext.EditUserCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            Background="#D97B35" Foreground="White" BorderThickness="0" FontSize="11"/>
                                    <Button Content="Del" Margin="2" Padding="8,2"
                                            Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            Background="#EF4444" Foreground="White" BorderThickness="0" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock DockPanel.Dock="Top" Foreground="#9CA3AF" FontSize="12" Margin="0,12,0,0"
                       Text="{Binding StatusMessage}"/>
        </DockPanel>
        <ScrollViewer Visibility="{Binding IsEditing, Converter={StaticResource BTV}}">
            <StackPanel MaxWidth="480" HorizontalAlignment="Left">
                <TextBlock Text="User Details" Style="{StaticResource SectionHeader}"/>
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="Full Name *" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Foreground="White" Background="#1A1A1A" Margin="0,0,0,12"/>
                        <TextBlock Text="Email" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditEmail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Foreground="White" Background="#1A1A1A" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="PIN (4-6 digits) *" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditPin, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Foreground="White" Background="#1A1A1A" MaxLength="6"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Role *" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding EditRole}"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          Foreground="White" Background="#1A1A1A"/>
                            </StackPanel>
                        </Grid>
                        <CheckBox Content="Account Active" IsChecked="{Binding EditIsActive}" Foreground="White" Margin="0,0,0,16"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#EF4444" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Save User" Command="{Binding SaveUserCommand}" Style="{StaticResource OrangeButton}" Margin="0,0,8,0"/>
                            <Button Content="Cancel" Command="{Binding CancelEditCommand}" Style="{StaticResource GhostButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
