<Page x:Class="SpaceBusinessPOS.Views.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:vm="clr-namespace:SpaceBusinessPOS.ViewModels"
      Background="#111111" FontFamily="Segoe UI">
    <Page.DataContext><vm:ReportsViewModel/></Page.DataContext>
    <ScrollViewer>
    <StackPanel Margin="20">
        <TextBlock Text="Sales Reports" Style="{StaticResource SectionHeader}"/>

        <!-- Date Range -->
        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Date Range" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#9CA3AF"/>
                    <DatePicker SelectedDate="{Binding DateFrom}" Foreground="White" Background="#1A1A1A" Margin="0,0,16,0"/>
                    <TextBlock Text="To:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#9CA3AF"/>
                    <DatePicker SelectedDate="{Binding DateTo}" Foreground="White" Background="#1A1A1A" Margin="0,0,16,0"/>
                    <Button Content="Load" Command="{Binding LoadCommand}" Style="{StaticResource OrangeButton}" Margin="0,0,8,0"/>
                    <Button Content="Today" Command="{Binding SetTodayCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0"/>
                    <Button Content="Week" Command="{Binding SetThisWeekCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0"/>
                    <Button Content="Month" Command="{Binding SetThisMonthCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0"/>
                    <Button Content="Year" Command="{Binding SetThisYearCommand}" Style="{StaticResource GhostButton}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- KPI Cards -->
        <WrapPanel Margin="0,0,0,16">
            <Border Style="{StaticResource CardPanel}" Width="200" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Total Sales" Foreground="#9CA3AF" FontSize="12"/>
                    <TextBlock FontSize="28" FontWeight="Bold" Foreground="#D97B35" Margin="0,4,0,0">
                        <Run Text="{Binding CurrencySymbol}"/>
                        <Run Text="{Binding Summary.TotalSales, StringFormat={}{0:F2}}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardPanel}" Width="200" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Transactions" Foreground="#9CA3AF" FontSize="12"/>
                    <TextBlock Text="{Binding Summary.TransactionCount}" FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardPanel}" Width="200" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Avg. Transaction" Foreground="#9CA3AF" FontSize="12"/>
                    <TextBlock FontSize="28" FontWeight="Bold" Margin="0,4,0,0">
                        <Run Text="{Binding CurrencySymbol}"/>
                        <Run Text="{Binding Summary.AverageTransaction, StringFormat={}{0:F2}}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardPanel}" Width="200" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Total Tax" Foreground="#9CA3AF" FontSize="12"/>
                    <TextBlock FontSize="28" FontWeight="Bold" Margin="0,4,0,0" Foreground="#F59E0B">
                        <Run Text="{Binding CurrencySymbol}"/>
                        <Run Text="{Binding Summary.TotalTax, StringFormat={}{0:F2}}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardPanel}" Width="200" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Expenses" Foreground="#9CA3AF" FontSize="12"/>
                    <TextBlock FontSize="28" FontWeight="Bold" Margin="0,4,0,0" Foreground="#EF4444">
                        <Run Text="{Binding CurrencySymbol}"/>
                        <Run Text="{Binding Summary.TotalExpenses, StringFormat={}{0:F2}}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardPanel}" Width="200">
                <StackPanel>
                    <TextBlock Text="Net Profit" Foreground="#9CA3AF" FontSize="12"/>
                    <TextBlock FontSize="28" FontWeight="Bold" Margin="0,4,0,0" Foreground="#22C55E">
                        <Run Text="{Binding CurrencySymbol}"/>
                        <Run Text="{Binding Summary.NetProfit, StringFormat={}{0:F2}}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </WrapPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Top Products -->
            <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                <StackPanel>
                    <TextBlock Text="Top Products" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12"/>
                    <DataGrid ItemsSource="{Binding Summary.TopProducts}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              Background="Transparent" Foreground="White"
                              RowBackground="Transparent" BorderThickness="0"
                              GridLinesVisibility="None" CanUserResizeRows="False" MaxHeight="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="Qty Sold" Binding="{Binding QuantitySold}" Width="80"/>
                            <DataGridTextColumn Header="Revenue" Binding="{Binding Revenue, StringFormat='{}{0:F2}'}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Daily Sales -->
            <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                <StackPanel>
                    <TextBlock Text="Daily Sales" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12"/>
                    <DataGrid ItemsSource="{Binding Summary.DailySalesData}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              Background="Transparent" Foreground="White"
                              RowBackground="Transparent" BorderThickness="0"
                              GridLinesVisibility="None" CanUserResizeRows="False" MaxHeight="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="120"/>
                            <DataGridTextColumn Header="Transactions" Binding="{Binding Transactions}" Width="100"/>
                            <DataGridTextColumn Header="Sales" Binding="{Binding Sales, StringFormat='{}{0:F2}'}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
    </ScrollViewer>
</Page>
