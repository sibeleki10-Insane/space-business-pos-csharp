<Page x:Class="SpaceBusinessPOS.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:vm="clr-namespace:SpaceBusinessPOS.ViewModels"
      Background="#111111" FontFamily="Segoe UI">
    <Page.DataContext><vm:SettingsViewModel/></Page.DataContext>
    <ScrollViewer>
    <StackPanel Margin="20" MaxWidth="680" HorizontalAlignment="Left">
        <TextBlock Text="Settings" Style="{StaticResource SectionHeader}"/>

        <!-- General -->
        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="General" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Business / Location Name" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding LocationName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Foreground="White" Background="#1A1A1A"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Tax Rate (%)" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding TaxRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Foreground="White" Background="#1A1A1A"/>
                    </StackPanel>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Currency Code (e.g. USD)" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Currency, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Foreground="White" Background="#1A1A1A"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Currency Symbol (e.g. $)" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding CurrencySymbol, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Foreground="White" Background="#1A1A1A"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Printer -->
        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Printer Setup" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12"/>
                <TextBlock Text="Select Printer" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Foreground="White" Background="#1A1A1A" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshPrintersCommand}"
                            Style="{StaticResource GhostButton}" FontSize="12"/>
                </Grid>
                <CheckBox Content="Auto-print receipt after checkout" IsChecked="{Binding AutoPrintReceipt}" Foreground="White" Margin="0,0,0,12"/>
                <Button Content="Print Test Page" Command="{Binding TestPrintCommand}" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>

        <!-- Cloud Sync -->
        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Supabase Cloud Sync" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"/>
                <TextBlock Text="Configure your Supabase project for cloud backup and sync" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,12"/>
                <TextBlock Text="Supabase Project URL" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,4"/>
                <TextBox Text="{Binding SupabaseUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Foreground="White" Background="#1A1A1A" Margin="0,0,0,12"/>
                <TextBlock Text="Supabase Anon Key" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,4"/>
                <TextBox Text="{Binding SupabaseKey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Foreground="White" Background="#1A1A1A"/>
            </StackPanel>
        </Border>

        <!-- Other -->
        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Notifications" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12"/>
                <CheckBox Content="Show low stock alerts" IsChecked="{Binding LowStockAlert}" Foreground="White"/>
            </StackPanel>
        </Border>

        <!-- Status + Save -->
        <TextBlock Text="{Binding StatusMessage}" Foreground="#22C55E" FontSize="13" Margin="0,0,0,8"/>
        <Button Content="Save Settings" Command="{Binding SaveCommand}" Style="{StaticResource OrangeButton}" HorizontalAlignment="Left"/>
    </StackPanel>
    </ScrollViewer>
</Page>
