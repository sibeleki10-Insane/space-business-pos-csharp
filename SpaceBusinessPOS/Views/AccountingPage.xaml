<Page x:Class="SpaceBusinessPOS.Views.AccountingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:vm="clr-namespace:SpaceBusinessPOS.ViewModels"
      xmlns:conv="clr-namespace:SpaceBusinessPOS.Converters"
      Background="#111111" FontFamily="Segoe UI">
    <Page.DataContext><vm:AccountingViewModel/></Page.DataContext>
    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BTV"/>
        <conv:InverseBoolToVisibilityConverter x:Key="IBTV"/>
        <conv:ProfitColorConverter x:Key="ProfitColor"/>
    </Page.Resources>
    <Grid Margin="20">
        <DockPanel Visibility="{Binding IsEditing, Converter={StaticResource IBTV}}">
            <TextBlock DockPanel.Dock="Top" Text="Accounting" Style="{StaticResource SectionHeader}"/>

            <!-- Summary Cards -->
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <Border Style="{StaticResource CardPanel}" Width="220" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Income (Sales)" Foreground="#9CA3AF" FontSize="12"/>
                        <TextBlock FontSize="26" FontWeight="Bold" Foreground="#22C55E" Margin="0,4,0,0">
                            <Run Text="{Binding CurrencySymbol}"/>
                            <Run Text="{Binding Income, StringFormat={}{0:F2}}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardPanel}" Width="220" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Expenses" Foreground="#9CA3AF" FontSize="12"/>
                        <TextBlock FontSize="26" FontWeight="Bold" Foreground="#EF4444" Margin="0,4,0,0">
                            <Run Text="{Binding CurrencySymbol}"/>
                            <Run Text="{Binding TotalExpenses, StringFormat={}{0:F2}}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardPanel}" Width="220">
                    <StackPanel>
                        <TextBlock Text="Net Profit / Loss" Foreground="#9CA3AF" FontSize="12"/>
                        <TextBlock FontSize="26" FontWeight="Bold" Margin="0,4,0,0">
                            <TextBlock.Foreground>
                                <Binding Path="Profit" Converter="{StaticResource ProfitColor}"/>
                            </TextBlock.Foreground>
                            <Run Text="{Binding CurrencySymbol}"/>
                            <Run Text="{Binding Profit, StringFormat={}{0:F2}}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Filters + Add button -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#9CA3AF"/>
                    <DatePicker SelectedDate="{Binding DateFrom}" Foreground="White" Background="#232323" Margin="0,0,16,0"/>
                    <TextBlock Text="To:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#9CA3AF"/>
                    <DatePicker SelectedDate="{Binding DateTo}" Foreground="White" Background="#232323" Margin="0,0,16,0"/>
                    <Button Content="Load" Command="{Binding LoadCommand}" Style="{StaticResource OrangeButton}" Margin="0,0,8,0"/>
                    <Button Content="This Month" Command="{Binding SetThisMonthCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0"/>
                    <Button Content="Last Month" Command="{Binding SetLastMonthCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0"/>
                    <Button Content="This Year" Command="{Binding SetThisYearCommand}" Style="{StaticResource GhostButton}"/>
                </StackPanel>
                <Button Content="+ Add Expense" HorizontalAlignment="Right"
                        Command="{Binding NewExpenseCommand}" Style="{StaticResource OrangeButton}"/>
            </Grid>

            <DataGrid DockPanel.Dock="Top" ItemsSource="{Binding Expenses}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      Background="#1A1A1A" Foreground="White"
                      RowBackground="#232323" AlternatingRowBackground="#1E1E1E"
                      BorderThickness="0" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#2D2D2D"
                      CanUserResizeRows="False" SelectionMode="Single">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#1A1A1A"/>
                        <Setter Property="Foreground" Value="#9CA3AF"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#2D2D2D"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding ExpenseDate, StringFormat='{}{0:yyyy-MM-dd}'}" Width="100"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"/>
                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='{}{0:F2}'}" Width="100"/>
                    <DataGridTextColumn Header="Payment" Binding="{Binding PaymentMethod}" Width="100"/>
                    <DataGridTextColumn Header="Recorded By" Binding="{Binding RecordedBy}" Width="120"/>
                    <DataGridTemplateColumn Header="Actions" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Edit" Margin="2" Padding="8,2"
                                            Command="{Binding DataContext.EditExpenseCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            Background="#D97B35" Foreground="White" BorderThickness="0" FontSize="11"/>
                                    <Button Content="Del" Margin="2" Padding="8,2"
                                            Command="{Binding DataContext.DeleteExpenseCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            Background="#EF4444" Foreground="White" BorderThickness="0" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- Expense Form -->
        <ScrollViewer Visibility="{Binding IsEditing, Converter={StaticResource BTV}}">
            <StackPanel MaxWidth="520" HorizontalAlignment="Left">
                <TextBlock Text="Expense Details" Style="{StaticResource SectionHeader}"/>
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="Description *" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Foreground="White" Background="#1A1A1A" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Amount *" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditAmount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Foreground="White" Background="#1A1A1A"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Date" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,4"/>
                                <DatePicker SelectedDate="{Binding EditDate}" Foreground="White" Background="#1A1A1A"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Category" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding ExpenseCategories}" SelectedItem="{Binding EditCategory}"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}" Foreground="White" Background="#1A1A1A"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Payment Method" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding EditPaymentMethod}"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}" Foreground="White" Background="#1A1A1A"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Notes" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Foreground="White" Background="#1A1A1A" AcceptsReturn="True" Height="60" Margin="0,0,0,16"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#EF4444" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Save Expense" Command="{Binding SaveExpenseCommand}" Style="{StaticResource OrangeButton}" Margin="0,0,8,0"/>
                            <Button Content="Cancel" Command="{Binding CancelEditCommand}" Style="{StaticResource GhostButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
