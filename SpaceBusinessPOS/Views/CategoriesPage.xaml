<Page x:Class="SpaceBusinessPOS.Views.CategoriesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:vm="clr-namespace:SpaceBusinessPOS.ViewModels"
      xmlns:conv="clr-namespace:SpaceBusinessPOS.Converters"
      Background="#111111" FontFamily="Segoe UI">
    <Page.DataContext><vm:CategoriesViewModel/></Page.DataContext>
    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BTV"/>
        <conv:InverseBoolToVisibilityConverter x:Key="IBTV"/>
    </Page.Resources>
    <Grid Margin="20">
        <DockPanel Visibility="{Binding IsEditing, Converter={StaticResource IBTV}}">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                <TextBlock Text="Categories" Style="{StaticResource SectionHeader}" VerticalAlignment="Center"/>
                <Button Content="+ New Category" HorizontalAlignment="Right" Command="{Binding NewCategoryCommand}" Style="{StaticResource OrangeButton}"/>
            </Grid>
            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Categories}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#232323" CornerRadius="8" Padding="16,12" Margin="0,0,12,12" Width="200">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Ellipse Width="16" Height="16" Margin="0,0,8,0">
                                        <Ellipse.Fill><SolidColorBrush Color="{Binding Color}"/></Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Edit" Padding="12,4" Margin="0,0,8,0"
                                            Command="{Binding DataContext.EditCategoryCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            Background="#D97B35" Foreground="White" BorderThickness="0" FontSize="12"/>
                                    <Button Content="Delete" Padding="12,4"
                                            Command="{Binding DataContext.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            Background="#EF4444" Foreground="White" BorderThickness="0" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
        <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BTV}}" MaxWidth="400" HorizontalAlignment="Left">
            <TextBlock Text="Category Details" Style="{StaticResource SectionHeader}"/>
            <Border Style="{StaticResource CardPanel}">
                <StackPanel>
                    <TextBlock Text="Name *" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Foreground="White" Background="#1A1A1A" Margin="0,0,0,12"/>
                    <TextBlock Text="Color (hex, e.g. #D97B35)" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding EditColor, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Foreground="White" Background="#1A1A1A" Margin="0,0,0,16"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#EF4444" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Save" Command="{Binding SaveCategoryCommand}" Style="{StaticResource OrangeButton}" Margin="0,0,8,0"/>
                        <Button Content="Cancel" Command="{Binding CancelEditCommand}" Style="{StaticResource GhostButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
