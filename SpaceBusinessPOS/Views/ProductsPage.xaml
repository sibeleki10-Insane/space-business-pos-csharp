<Page x:Class="SpaceBusinessPOS.Views.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:vm="clr-namespace:SpaceBusinessPOS.ViewModels"
      xmlns:conv="clr-namespace:SpaceBusinessPOS.Converters"
      Background="#111111" FontFamily="Segoe UI">

    <Page.DataContext><vm:ProductsViewModel/></Page.DataContext>
    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BTV"/>
        <conv:InverseBoolToVisibilityConverter x:Key="IBTV"/>
    </Page.Resources>

    <Grid Margin="20">
        <!-- List View -->
        <DockPanel Visibility="{Binding IsEditing, Converter={StaticResource IBTV}}">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="Products" Style="{StaticResource SectionHeader}" VerticalAlignment="Center"/>
                <Button Content="+ New Product" HorizontalAlignment="Right"
                        Command="{Binding NewProductCommand}" Style="{StaticResource OrangeButton}"/>
            </Grid>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Search products..."
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Width="320" HorizontalAlignment="Left" Foreground="White" Background="#232323"/>
            </Grid>
            <DataGrid DockPanel.Dock="Top" ItemsSource="{Binding Products}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      Background="#1A1A1A" Foreground="White"
                      RowBackground="#232323" AlternatingRowBackground="#1E1E1E"
                      BorderThickness="0" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#2D2D2D" HeadersVisibility="Column"
                      CanUserResizeRows="False" SelectionMode="Single">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#1A1A1A"/>
                        <Setter Property="Foreground" Value="#9CA3AF"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#2D2D2D"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="120"/>
                    <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="120"/>
                    <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat='{}{0:F2}'}" Width="80"/>
                    <DataGridTextColumn Header="Cost" Binding="{Binding Cost, StringFormat='{}{0:F2}'}" Width="80"/>
                    <DataGridTextColumn Header="Stock" Binding="{Binding StockQuantity}" Width="80"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="120"/>
                    <DataGridTemplateColumn Header="Actions" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Edit" Margin="2" Padding="8,2"
                                            Command="{Binding DataContext.EditProductCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            Background="#D97B35" Foreground="White" BorderThickness="0" FontSize="11"/>
                                    <Button Content="Del" Margin="2" Padding="8,2"
                                            Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            Background="#EF4444" Foreground="White" BorderThickness="0" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- Edit Form -->
        <ScrollViewer Visibility="{Binding IsEditing, Converter={StaticResource BTV}}">
            <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                <TextBlock Text="Product Details" Style="{StaticResource SectionHeader}"/>
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="Name *" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Foreground="White" Background="#1A1A1A" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SKU *" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditSku, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Foreground="White" Background="#1A1A1A"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Barcode" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditBarcode, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Foreground="White" Background="#1A1A1A"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Selling Price" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditPrice, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Foreground="White" Background="#1A1A1A"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Cost Price" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditCost, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Foreground="White" Background="#1A1A1A"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Stock Quantity" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditStock, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Foreground="White" Background="#1A1A1A"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Min Stock Alert" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditMinStock, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Foreground="White" Background="#1A1A1A"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Category" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Categories}"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding EditCategoryId}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Foreground="White" Background="#1A1A1A" Margin="0,0,0,12"/>

                        <CheckBox Content="Active" IsChecked="{Binding EditIsActive}" Foreground="White" Margin="0,0,0,12"/>

                        <TextBlock Text="{Binding StatusMessage}" Foreground="#EF4444" Margin="0,0,0,8"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Save Product" Command="{Binding SaveProductCommand}" Style="{StaticResource OrangeButton}" Margin="0,0,8,0"/>
                            <Button Content="Cancel" Command="{Binding CancelEditCommand}" Style="{StaticResource GhostButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
