<Page x:Class="SpaceBusinessPOS.Views.TransactionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:vm="clr-namespace:SpaceBusinessPOS.ViewModels"
      xmlns:conv="clr-namespace:SpaceBusinessPOS.Converters"
      Background="#111111" FontFamily="Segoe UI">
    <Page.DataContext><vm:TransactionsViewModel/></Page.DataContext>
    <Page.Resources>
        <conv:StatusColorConverter x:Key="StatusColor"/>
    </Page.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="220"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Transaction History" Style="{StaticResource SectionHeader}"/>

        <!-- Filters -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#9CA3AF"/>
            <DatePicker SelectedDate="{Binding DateFrom}" Foreground="White" Background="#232323" Margin="0,0,16,0"/>
            <TextBlock Text="To:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#9CA3AF"/>
            <DatePicker SelectedDate="{Binding DateTo}" Foreground="White" Background="#232323" Margin="0,0,16,0"/>
            <Button Content="Load" Command="{Binding LoadCommand}" Style="{StaticResource OrangeButton}"/>
        </StackPanel>

        <!-- Transaction List -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Transactions}"
                  SelectedItem="{Binding SelectedTransaction}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  Background="#1A1A1A" Foreground="White"
                  RowBackground="#232323" AlternatingRowBackground="#1E1E1E"
                  BorderThickness="0" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#2D2D2D"
                  CanUserResizeRows="False" SelectionMode="Single">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#1A1A1A"/>
                    <Setter Property="Foreground" Value="#9CA3AF"/>
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="#2D2D2D"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Number" Binding="{Binding TransactionNumber}" Width="160"/>
                <DataGridTextColumn Header="Date" Binding="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="140"/>
                <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/>
                <DataGridTextColumn Header="Cashier" Binding="{Binding CashierName}" Width="120"/>
                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat='{}{0:F2}'}" Width="90"/>
                <DataGridTextColumn Header="Payment" Binding="{Binding PaymentMethod}" Width="90"/>
                <DataGridTemplateColumn Header="Status" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Status}" FontWeight="SemiBold">
                                <TextBlock.Foreground>
                                    <Binding Path="Status" Converter="{StaticResource StatusColor}"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Actions" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Print" Margin="2" Padding="8,2"
                                        Command="{Binding DataContext.PrintReceiptCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        Background="#374151" Foreground="White" BorderThickness="0" FontSize="11"/>
                                <Button Content="Refund" Margin="2" Padding="8,2"
                                        Command="{Binding DataContext.RefundCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        Background="#EF4444" Foreground="White" BorderThickness="0" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Items Detail -->
        <Border Grid.Row="3" Background="#1A1A1A" Margin="0,12,0,0" CornerRadius="8" Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Items" FontWeight="SemiBold" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                <DataGrid ItemsSource="{Binding SelectedItems}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" Foreground="White"
                          RowBackground="Transparent" BorderThickness="0"
                          GridLinesVisibility="None" CanUserResizeRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="100"/>
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="60"/>
                        <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, StringFormat='{}{0:F2}'}" Width="90"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat='{}{0:F2}'}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</Page>
